---
import { SITE_NAME } from "@/lib/config";
---

<!-- Main footer -->
<div class="grid gap-10 py-12 sm:py-14 lg:grid-cols-[1.5fr_1fr_1fr] lg:gap-16">

  <!-- Brand -->
  <div class="max-w-md">
    <a
      href="/"
      class="inline-flex items-center gap-3 text-decoration-none"
      aria-label={`${SITE_NAME} — inicio`}
    >
      <span
        class="flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--color-brand)] text-sm font-semibold tracking-wide text-white shadow-[var(--shadow-soft)]"
        aria-hidden="true"
      >
        FPE
      </span>

      <span class="font-display text-xl font-medium tracking-tight text-[var(--color-brand-dark)]">
        {SITE_NAME}
      </span>
    </a>

    <p class="mt-5 max-w-sm text-sm leading-6 text-[var(--color-ink-muted)]">
      Un proyecto independiente para conocer, a través de datos, la realidad
      profesional de quienes trabajan en la Formación Profesional para el Empleo.
    </p>

    <div class="mt-5 flex flex-wrap gap-2">
      <span class="badge">Estudio independiente</span>
      <span class="badge">Datos agregados</span>
    </div>
  </div>

  <!-- Navigation -->
  <div>
    <h2 class="text-sm font-semibold text-[var(--color-ink)]">
      Explorar
    </h2>

    <nav class="mt-4 flex flex-col gap-2.5" aria-label="Navegación del pie de página">
      <a
        href="/"
        class="w-fit text-sm text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-brand)]"
      >
        Inicio
      </a>

      <a
        href="/estudios/docentes-fpe-2026/participar"
        class="w-fit text-sm text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-brand)]"
      >
        Participar en la encuesta
      </a>

      <a
        href="/informes"
        class="w-fit text-sm text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-brand)]"
      >
        Informes
      </a>

      <a
        href="/metodologia"
        class="w-fit text-sm text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-brand)]"
      >
        Metodología
      </a>

      <a
        href="/acerca-de"
        class="w-fit text-sm text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-brand)]"
      >
        Acerca del proyecto
      </a>
    </nav>
  </div>

  <!-- Transparency -->
  <div>
    <h2 class="text-sm font-semibold text-[var(--color-ink)]">
      Transparencia
    </h2>

    <div class="mt-4 space-y-3 text-sm leading-6 text-[var(--color-ink-muted)]">
      <p>
        No recopilamos nombre, email ni otros datos identificativos.
      </p>

      <p>
        Los resultados se muestran de forma agregada y se aplican
        umbrales mínimos para proteger la privacidad.
      </p>

      <a
        href="/privacidad"
        class="inline-flex font-medium text-[var(--color-brand)] underline decoration-[var(--color-brand-soft)] underline-offset-4 transition-colors hover:text-[var(--color-brand-dark)]"
      >
        Política de privacidad
      </a>
    </div>
  </div>
</div>

<!-- Bottom bar -->
<div class="flex flex-col gap-4 border-t border-[var(--color-line)] py-6 text-xs text-[var(--color-ink-muted)] sm:flex-row sm:items-center sm:justify-between">

  <p>
    © {new Date().getFullYear()} {SITE_NAME}
  </p>

  <div class="flex flex-wrap gap-x-5 gap-y-2">
    <a
      href="/privacidad"
      class="transition-colors hover:text-[var(--color-brand)]"
    >
      Privacidad
    </a>

    <button
      type="button"
      id="footer-contact-btn"
      class="cursor-pointer transition-colors hover:text-[var(--color-brand)]"
    >
      Contacto
    </button>

    <span>
      Proyecto independiente
    </span>
  </div>
</div>

<!-- Contact modal -->
<div
  id="contact-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="contact-modal-title"
>
  <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-xl">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2
          id="contact-modal-title"
          class="text-xl font-semibold text-[var(--color-ink)]"
        >
          Contacto
        </h2>

        <p class="mt-3 text-sm text-[var(--color-ink-muted)]">
          Puedes escribirme a:
        </p>

        <a
          href="mailto:hola@inmacontreras.com"
          class="mt-2 inline-block font-medium text-[var(--color-brand)] hover:underline"
        >
          hola@inmacontreras.com
        </a>
      </div>

      <button
        type="button"
        id="contact-modal-close"
        aria-label="Cerrar"
        class="cursor-pointer text-2xl leading-none text-gray-500 hover:text-gray-800"
      >
        ×
      </button>
    </div>
  </div>
</div>

<script>
  const contactButton = document.getElementById("footer-contact-btn");
  const contactModal = document.getElementById("contact-modal");
  const contactModalClose = document.getElementById("contact-modal-close");

  function openContactModal() {
    contactModal?.classList.remove("hidden");
    contactModal?.classList.add("flex");
  }

  function closeContactModal() {
    contactModal?.classList.add("hidden");
    contactModal?.classList.remove("flex");
  }

  contactButton?.addEventListener("click", openContactModal);
  contactModalClose?.addEventListener("click", closeContactModal);

  contactModal?.addEventListener("click", (event) => {
    if (event.target === contactModal) {
      closeContactModal();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeContactModal();
    }
  });
</script>