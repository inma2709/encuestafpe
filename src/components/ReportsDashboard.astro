---
import type { MetricId } from "@/services/analyticsTypes";
import type { ReportsView } from "@/types";
import ReportFilters from "./ReportFilters.astro";
import ReportMetric from "./ReportMetric.astro";
import ReportProfileComparison from "./ReportProfileComparison.astro";

interface Props { view: ReportsView; filterAction: string; }
const { view, filterAction } = Astro.props;
const metrics = new Map(view.metrics.map((metric) => [metric.metricId, metric]));
const metric = (id: MetricId) => metrics.get(id);
const profileMetric = metric("profile_composition");
const profiles = profileMetric && "options" in profileMetric ? profileMetric.options : [];
const chapters: Array<{ id: string; number: string; title: string; intro: string; metrics: MetricId[]; tone?: "aspiring" }> = [
  { id: "quienes-responden", number: "01", title: "Quiénes responden", intro: "La composición describe la muestra que ha participado; no representa por sí sola la distribución territorial o profesional del conjunto del sector.", metrics: ["profile_composition", "age_distribution", "gender_distribution", "education_distribution", "fpe_experience_distribution", "territorial_distribution", "main_family_distribution"] },
  { id: "trabajo", number: "02", title: "Cómo se trabaja en la FPE", intro: "Entre docentes actuales que respondieron, estas medidas describen modalidad, relación laboral y peso de la FPE en su actividad.", metrics: ["teaching_mode_distribution", "employment_relation_distribution", "entity_type_distribution", "fpe_main_activity", "fpe_activity_share", "centres_per_year"] },
  { id: "ingresos", number: "03", title: "Ingresos y dependencia económica", intro: "Los tramos de ingresos se muestran tal como fueron respondidos. No se convierten en un salario medio estimado.", metrics: ["annual_income_distribution", "income_dependency"] },
  { id: "no-remunerado", number: "04", title: "El trabajo que no se paga", intro: "Las tareas podían seleccionarse conjuntamente; sus porcentajes no tienen por qué sumar 100 %.", metrics: ["unpaid_hours_distribution", "unpaid_tasks_ranking", "materials_burden"] },
  { id: "estabilidad", number: "05", title: "Estabilidad y acceso al trabajo", intro: "Las respuestas muestran continuidad, previsibilidad y condiciones de acceso entre quienes participaron.", metrics: ["months_worked_distribution", "course_notice_distribution", "course_search_distribution", "work_availability_perception", "student_recruitment_difficulty"] },
  { id: "percepcion", number: "06", title: "Cómo se percibe el sector", intro: "Las valoraciones expresan la percepción de la muestra; no establecen relaciones de causa y efecto.", metrics: ["salary_adequacy_perception", "professional_recognition", "sector_problems_ranking"] },
  { id: "futuro", number: "07", title: "El futuro de la docencia FPE", intro: "Las expectativas recogen lo que declaran docentes y exdocentes que respondieron a la encuesta.", metrics: ["future_expectation_distribution"] },
  { id: "aspirantes", number: "09", title: "Entrar en la FPE", intro: "Este capítulo reúne exclusivamente las respuestas de personas que se preparan o intentan acceder a la docencia FPE.", metrics: ["aspiring_family_interest", "aspiring_requirements_knowledge", "aspiring_teaching_qualification", "aspiring_sector_experience", "aspiring_job_search", "aspiring_access_barriers", "aspiring_preferred_mode", "aspiring_economic_perception", "aspiring_hourly_rate_distribution"], tone: "aspiring" },
];
---

<section class="radiography">
  <header class="radiography__cover">
    <p class="eyebrow">Estudio independiente · edición 2026</p>
    <h1>Radiografía de la docencia en la Formación Profesional para el Empleo</h1>
    <p class="radiography__lede">Una lectura de las respuestas de profesionales y aspirantes que han participado en la encuesta.</p>
    <div class="radiography__sample">
      <div><strong>{view.totalSessions}</strong><span>respuestas válidas</span></div>
      <dl>
        {profiles.map((profile) => <div><dt>{profile.label}</dt><dd>{profile.count}</dd></div>)}
      </dl>
    </div>
    <p class="radiography__method">Estudio creado en agosto de 2026. Los resultados describen la muestra obtenida y cada indicador informa de su base de respuestas válidas.</p>
  </header>

  <nav class="radiography__nav" aria-label="Capítulos de la radiografía">
    <a href="#resumen">Resumen</a>
    {chapters.map((chapter) => <a href={`#${chapter.id}`}>{chapter.number} · {chapter.title}</a>)}
    <a href="#metodologia">Metodología</a>
  </nav>

  <ReportFilters view={view} action={filterAction} />

  <section id="resumen" class="radiography__summary" aria-labelledby="summary-title">
    <div><p class="eyebrow">Lectura inicial</p><h2 id="summary-title">Principales resultados</h2></div>
    {view.insightHeadlines.length ? (
      <ol>{view.insightHeadlines.slice(0, 8).map((headline) => <li><span>{headline.text}</span><small>n={headline.n}</small></li>)}</ol>
    ) : (
      <p class="radiography__empty">Aún no hay suficiente base para destacar resultados de forma responsable.</p>
    )}
  </section>

  {chapters.map((chapter) => (
    <section id={chapter.id} class:list={["report-chapter", { "report-chapter--aspiring": chapter.tone === "aspiring" }]} aria-labelledby={`${chapter.id}-title`}>
      <header class="report-chapter__intro"><p>{chapter.number}</p><div><h2 id={`${chapter.id}-title`}>{chapter.title}</h2><p>{chapter.intro}</p></div></header>
      <div class="report-chapter__grid">
        {chapter.metrics.map((id, index) => <ReportMetric metric={metric(id)} featured={index < 2} />)}
      </div>
    </section>
  ))}

  <section id="docentes-exdocentes" class="report-chapter report-chapter--pending" aria-labelledby="compare-title">
    <header class="report-chapter__intro"><p>08</p><div><h2 id="compare-title">Docentes actuales y exdocentes</h2><p>La comparativa se publicará únicamente para indicadores y grupos que alcancen una base suficiente en ambos perfiles.</p></div></header>
    <div class="report-chapter__grid">{view.profileComparisons.map((comparison) => <ReportProfileComparison comparison={comparison} />)}</div>
  </section>

  <section id="metodologia" class="radiography__methodology" aria-labelledby="method-title">
    <p class="eyebrow">Cómo leer los datos</p>
    <h2 id="method-title">Metodología</h2>
    <div>
      <p>La encuesta es independiente y recoge respuestas anónimas de docentes actuales, exdocentes y aspirantes a la docencia FPE. No se solicitan datos identificativos en el cuestionario.</p>
      <p>El denominador cambia según la pregunta: cada resultado muestra sus respuestas válidas y la población a la que correspondía. En preguntas de selección múltiple, una misma persona puede figurar en varias opciones.</p>
      <p>Los desgloses con muestra insuficiente no se publican y las bases reducidas se señalan. Los resultados describen la muestra obtenida; las diferencias observadas no prueban causalidad ni equivalen a una estimación nacional.</p>
    </div>
  </section>
</section>

<style>
  .radiography { display: grid; gap: clamp(2.5rem, 6vw, 5rem); }
  .radiography__cover { max-width: 58rem; padding: clamp(1.5rem, 5vw, 3.5rem); border: 1px solid var(--color-line); border-radius: var(--radius-lg); background: linear-gradient(135deg, rgb(74 92 60 / .11), var(--color-surface) 58%); }
  .radiography__cover h1 { max-width: 18ch; margin: .65rem 0 1rem; font-size: clamp(2.25rem, 7vw, 4.6rem); line-height: 1.02; }
  .radiography__lede { max-width: 42rem; margin: 0; color: var(--color-ink-muted); font-size: clamp(1.05rem, 2.4vw, 1.25rem); }
  .radiography__sample { display: grid; gap: 1.25rem; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--color-line-strong); }
  .radiography__sample > div strong { display: block; color: var(--color-brand-dark); font-family: var(--font-display); font-size: clamp(3rem, 8vw, 5.25rem); line-height: .9; }
  .radiography__sample > div span { color: var(--color-ink-muted); font-size: .9rem; }
  .radiography__sample dl { display: grid; gap: .55rem; margin: 0; }
  .radiography__sample dl div { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: .45rem; border-bottom: 1px solid rgb(205 215 200 / .7); }
  .radiography__sample dt { color: var(--color-ink-muted); } .radiography__sample dd { margin: 0; font-weight: 700; }
  .radiography__method { margin: 1.25rem 0 0; color: var(--color-ink-muted); font-size: .85rem; }
  .radiography__nav { display: flex; gap: .5rem 1rem; overflow-x: auto; padding-bottom: .4rem; border-bottom: 1px solid var(--color-line); white-space: nowrap; scrollbar-width: thin; }
  .radiography__nav a { color: var(--color-ink-muted); font-size: .85rem; text-decoration: none; } .radiography__nav a:hover { color: var(--color-brand-dark); text-decoration: underline; }
  .radiography__summary { display: grid; gap: 1.25rem; padding: clamp(1.25rem, 4vw, 2.25rem); border-radius: var(--radius-lg); background: var(--color-brand-dark); color: #f7faf4; }
  .radiography__summary h2 { margin: .35rem 0 0; color: inherit; font-size: clamp(1.7rem, 5vw, 2.5rem); } .radiography__summary .eyebrow { color: #c6d7bd; }
  .radiography__summary ol { display: grid; gap: .75rem; margin: 0; padding: 0; list-style: none; } .radiography__summary li { display: flex; justify-content: space-between; gap: 1rem; padding: .75rem 0; border-bottom: 1px solid rgb(255 255 255 / .16); } .radiography__summary small { flex: 0 0 auto; color: #dce8d6; }
  .report-chapter { scroll-margin-top: 5.5rem; } .report-chapter__intro { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: .75rem; margin-bottom: 1.25rem; } .report-chapter__intro > p { margin: .25rem 0 0; color: var(--color-sage); font-size: .8rem; font-weight: 700; letter-spacing: .08em; } .report-chapter__intro h2 { margin: 0; font-size: clamp(1.8rem, 5vw, 3rem); } .report-chapter__intro div > p { max-width: 48rem; margin: .65rem 0 0; color: var(--color-ink-muted); }
  .report-chapter__grid { display: grid; gap: .85rem; } .report-chapter--aspiring { padding: clamp(1rem, 3vw, 2rem); border-radius: var(--radius-lg); background: rgb(74 92 60 / .055); } .report-chapter--pending { border-top: 1px solid var(--color-line); padding-top: 2rem; }
  .radiography__methodology { scroll-margin-top: 5.5rem; padding-top: 2rem; border-top: 1px solid var(--color-line-strong); } .radiography__methodology h2 { margin: .5rem 0 1rem; font-size: clamp(1.8rem, 5vw, 2.8rem); } .radiography__methodology div { display: grid; gap: .75rem; max-width: 56rem; color: var(--color-ink-muted); } .radiography__methodology p { margin: 0; }
  .radiography__empty { margin: 0; color: var(--color-ink-muted); }
  @media (min-width: 640px) { .radiography__sample { grid-template-columns: minmax(11rem, .8fr) minmax(16rem, 1fr); align-items: end; } .report-chapter__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .report-chapter__grid :global(.report-metric--featured) { grid-column: span 2; } }
  @media (min-width: 1024px) { .report-chapter__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .report-chapter__grid :global(.report-metric--featured) { grid-column: span 1; } .radiography__summary { grid-template-columns: minmax(14rem, .7fr) 1.3fr; align-items: start; } }
</style>
