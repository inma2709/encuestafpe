---
import type { GroupedMetricResult, MetricOptionResult, MetricResult } from "@/services/analyticsTypes";

interface Props { comparison: GroupedMetricResult; }
const { comparison } = Astro.props;
const teacher = comparison.groups.teacher;
const former = comparison.groups.former_teacher;
const hasOptions = (result: MetricResult): result is MetricResult & { options: MetricOptionResult[] } => "options" in result;
const publishable = hasOptions(teacher) && hasOptions(former) && teacher.sampleStatus !== "hidden" && former.sampleStatus !== "hidden";
const byCode = (result: MetricResult & { options: MetricOptionResult[] }) => new Map(result.options.map((option) => [option.code, option]));
const teacherOptions = hasOptions(teacher) ? byCode(teacher) : new Map<string, MetricOptionResult>();
const formerOptions = hasOptions(former) ? byCode(former) : new Map<string, MetricOptionResult>();
const rows = [...new Set([...teacherOptions.keys(), ...formerOptions.keys()])]
  .map((code) => ({ code, teacher: teacherOptions.get(code), former: formerOptions.get(code) }))
  .sort((a, b) => ((b.teacher?.count ?? 0) + (b.former?.count ?? 0)) - ((a.teacher?.count ?? 0) + (a.former?.count ?? 0)))
  .slice(0, 5);
---

<article class="profile-comparison">
  <h3>{teacher.label}</h3>
  {publishable ? (
    <div class="profile-comparison__rows">
      {rows.map((row) => (
        <div class="profile-comparison__row">
          <p>{row.teacher?.label ?? row.former?.label}</p>
          <div class="profile-comparison__value"><span>Docentes actuales</span><div class="profile-comparison__rail"><i style={`width:${row.teacher?.percentage ?? 0}%`}></i></div><strong>{row.teacher?.percentage ?? 0} %</strong><small>n={row.teacher?.count ?? 0}</small></div>
          <div class="profile-comparison__value profile-comparison__value--former"><span>Exdocentes</span><div class="profile-comparison__rail"><i style={`width:${row.former?.percentage ?? 0}%`}></i></div><strong>{row.former?.percentage ?? 0} %</strong><small>n={row.former?.count ?? 0}</small></div>
        </div>
      ))}
    </div>
  ) : <p class="profile-comparison__empty">Muestra insuficiente para publicar esta comparación entre perfiles.</p>}
  <p class="profile-comparison__meta">Docentes actuales: n={teacher.denominator.nValid}. Exdocentes: n={former.denominator.nValid}. Los porcentajes se calculan dentro de cada perfil.</p>
</article>

<style>
  .profile-comparison { padding: 1.15rem; border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); }
  h3 { margin: 0; font-size: 1.12rem; } .profile-comparison__rows { display: grid; gap: 1.1rem; margin-top: 1.1rem; } .profile-comparison__row { padding-top: .9rem; border-top: 1px solid var(--color-line); } .profile-comparison__row > p { margin: 0 0 .5rem; font-size: .9rem; font-weight: 700; }
  .profile-comparison__value { display: grid; grid-template-columns: 6.3rem minmax(2rem, 1fr) auto auto; gap: .45rem; align-items: center; margin-top: .3rem; color: var(--color-ink-muted); font-size: .74rem; } .profile-comparison__value strong { color: var(--color-ink); font-size: .8rem; } .profile-comparison__value--former i { background: var(--color-accent-soft); }
  .profile-comparison__rail { height: .4rem; overflow: hidden; border-radius: 99px; background: var(--color-paper-deep); } .profile-comparison__rail i { display: block; height: 100%; background: var(--color-brand); } .profile-comparison__empty { margin: 1rem 0 0; padding: .8rem; background: var(--color-paper); color: var(--color-ink-muted); } .profile-comparison__meta { margin: 1rem 0 0; color: var(--color-ink-muted); font-size: .78rem; }
  @media (min-width: 640px) { .profile-comparison { padding: 1.35rem; } }
</style>
