---
import type { ReportsView } from "@/types";

interface Props { view: ReportsView; action: string; }
const { view, action } = Astro.props;
const f = view.filters;
const hasFilters = Boolean(f.ccaaCode || f.familyCode || f.modeCode || f.relationCode || f.experienceCode);
---

<details class="report-filters" open={hasFilters}>
  <summary>
    <span>Filtrar la lectura</span>
    {hasFilters ? <small>Hay filtros activos</small> : <small>Opcional</small>}
  </summary>
  <form method="get" action={action}>
    <p>Los filtros se aplican solo a los indicadores para los que son conceptualmente válidos.</p>
    <div class="report-filters__grid">
      <label>Comunidad autónoma
        <select name="ccaa"><option value="">Todas</option>{view.filterOptions.ccaa.map((x) => <option value={x.code} selected={f.ccaaCode === x.code}>{x.label}</option>)}</select>
      </label>
      <label>Familia profesional
        <select name="familia"><option value="">Todas</option>{view.filterOptions.families.map((x) => <option value={x.code} selected={f.familyCode === x.code}>{x.label}</option>)}</select>
      </label>
      <label>Modalidad
        <select name="modalidad"><option value="">Todas</option>{view.filterOptions.modes.map((x) => <option value={x.code} selected={f.modeCode === x.code}>{x.label}</option>)}</select>
      </label>
      <label>Relación laboral
        <select name="relacion"><option value="">Todas</option>{view.filterOptions.relations.map((x) => <option value={x.code} selected={f.relationCode === x.code}>{x.label}</option>)}</select>
      </label>
      <label>Experiencia en FPE
        <select name="experiencia"><option value="">Todas</option>{view.filterOptions.experiences.map((x) => <option value={x.code} selected={f.experienceCode === x.code}>{x.label}</option>)}</select>
      </label>
    </div>
    <div class="report-filters__actions"><button class="btn btn-primary" type="submit">Aplicar filtros</button>{hasFilters && <a class="btn btn-ghost" href={action}>Limpiar filtros</a>}</div>
  </form>
</details>

<style>
  .report-filters { border-block: 1px solid var(--color-line); padding: .9rem 0; }
  summary { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; cursor: pointer; color: var(--color-brand-dark); font-weight: 700; }
  summary small { color: var(--color-ink-muted); font-weight: 400; }
  form { padding-top: 1rem; }
  form > p { margin: 0 0 1rem; color: var(--color-ink-muted); font-size: .9rem; }
  .report-filters__grid { display: grid; gap: .75rem; }
  label { display: grid; gap: .35rem; color: var(--color-ink-muted); font-size: .82rem; font-weight: 600; }
  select { min-height: 2.8rem; width: 100%; border: 1px solid var(--color-line-strong); border-radius: var(--radius-sm); padding: .5rem .65rem; background: var(--color-surface); color: var(--color-ink); font: inherit; }
  .report-filters__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1rem; }
  @media (min-width: 680px) { .report-filters__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
