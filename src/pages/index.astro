---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { loadSurveySessions } from "@/services";

const studySlug = "docentes-fpe-2026";
let participantCount = 0;

try {
  const { sessions } = await loadSurveySessions(studySlug);
  participantCount = sessions.length;
} catch (error) {
  console.error("Error al obtener contador de participantes:", error);
}
---

<BaseLayout width="wide">
  <section class="home-hero">
    <div class="shell-wide home-hero__grid">
      <div class="home-hero__content fade-up">
        <p class="eyebrow">Estudio independiente · España · Agosto 2026</p>
        <h1 class="home-hero__title text-balance">
          ¿Cómo es realmente trabajar como docente de FPE?
        </h1>
        <p class="home-hero__intro">
          Este estudio recoge la experiencia de docentes de Formación Profesional para el Empleo para conocer su realidad profesional, detectar tendencias y hacerlas visibles.
        </p>
        <p class="lede home-hero__lede">
          Participa en una encuesta anónima de pocos minutos y ayuda a construir, con datos del propio colectivo, una visión más clara de las condiciones y la situación de quienes impartimos FPE.
        </p>

        <div class="home-hero__actions">
          <a href="/estudios/docentes-fpe-2026/participar" class="btn btn-primary btn-full sm:w-auto">
            Participar en la encuesta
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="/informes" class="editorial-link">
            Consultar informes
            <Icon name="arrow-right" size={16} />
          </a>
        </div>

        <dl class="home-hero__details" aria-label="Características de la encuesta">
          <div>
            <dt><Icon name="shield-check" size={17} /> Anonimato</dt>
            <dd>No pedimos datos identificativos.</dd>
          </div>
          <div>
            <dt><Icon name="users" size={17} /> Participación</dt>
            <dd>Sin registro y en pocos minutos.</dd>
          </div>
        </dl>
      </div>

      <figure class="home-hero__figure fade-up" style="animation-delay: 100ms;">
        <img
          src="/encuestas.png"
          width="920"
          height="920"
          alt="Ilustración de docentes participando en una encuesta"
          class="home-hero__image"
        />
        <figcaption>Una mirada colectiva sobre la docencia en FPE.</figcaption>
      </figure>
    </div>
  </section>

  <section class="home-evidence" aria-labelledby="datos-title">
    <div class="shell-wide">
      <div class="home-evidence__heading">
        <p class="eyebrow">El estudio en cifras</p>
        <h2 id="datos-title">Datos para comprender una profesión diversa</h2>
        <p>Las respuestas anónimas se convierten en una fotografía compartida de la docencia en Formación Profesional para el Empleo.</p>
      </div>

      <dl class="home-stats">
        <div class="fade-up" style="animation-delay: 100ms;">
          <dt>{participantCount}</dt>
          <dd>Docentes participantes</dd>
        </div>
        <div class="fade-up" style="animation-delay: 160ms;">
          <dt>17</dt>
          <dd>Comunidades autónomas</dd>
        </div>
        <div class="fade-up" style="animation-delay: 220ms;">
          <dt>26</dt>
          <dd>Familias profesionales</dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>
