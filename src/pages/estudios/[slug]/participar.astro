---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SurveyForm from "@/components/SurveyForm.astro";
import { getUnlockCookie, setUnlockCookie } from "@/lib/cookies";
import { DomainError } from "@/types";
import { getActiveSurvey, isUnlockTokenValid, submitSurveyForm } from "@/services";

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/");
}

let errorMessage: string | undefined;
const unlockToken = getUnlockCookie(Astro.cookies, slug);
const alreadyCompleted = await isUnlockTokenValid(slug, unlockToken);

// Migrate valid cookies issued before the API needed the site-wide cookie path.
if (alreadyCompleted && unlockToken) {
  setUnlockCookie(Astro.cookies, slug, unlockToken);
}

if (alreadyCompleted && Astro.request.method === "POST") {
  Astro.response.status = 409;
}

if (Astro.request.method === "POST" && !alreadyCompleted) {
  try {
    const form = await Astro.request.formData();
    const result = await submitSurveyForm(form, slug);

    setUnlockCookie(Astro.cookies, result.studySlug, result.unlockToken);
    return Astro.redirect(`/estudios/${result.studySlug}/resultados?submitted=1`);
  } catch (err) {
    console.error("Survey submission failed", {
      studySlug: slug,
      error: err,
    });
    Astro.response.status = err instanceof DomainError && err.code === "VALIDATION" ? 400 : 500;
    errorMessage = "No se ha podido enviar la encuesta. Inténtalo de nuevo.";
  }
}

let survey;
try {
  survey = await getActiveSurvey(slug);
} catch (err) {
  if (err instanceof DomainError && (err.code === "NOT_FOUND" || err.code === "CLOSED")) {
    return Astro.redirect(`/estudios/${slug}`);
  }
  throw err;
}

if (survey.study.status !== "open") {
  return Astro.redirect(`/estudios/${slug}`);
}
---

<BaseLayout title={`Participar · ${survey.study.title}`} width="narrow">
  <div class="mb-8 space-y-4 fade-up sm:mb-10">
    <p class="text-sm text-[var(--color-ink-muted)]">
      <a href={`/estudios/${survey.study.slug}`} class="nav-link inline-flex items-center gap-1">
        <span class="inline-block" style="transform: translateY(1px);">←</span>
        <span>Volver al estudio</span>
      </a>
    </p>
    <h1 class="font-display text-2xl sm:text-3xl lg:text-4xl text-balance">Encuesta sobre el sector de la FPE</h1>
    <p class="lede text-sm sm:text-base">
      Los campos con * son obligatorios. Solo el comentario final es opcional. 
    </p>
  </div>

  {
    alreadyCompleted ? (
      <section class="chapter fade-up space-y-5" role="status">
        <p class="eyebrow">Encuesta ya completada</p>
        <h2 class="font-display text-2xl sm:text-3xl">Ya has participado en esta encuesta.</h2>
        <p class="text-[var(--color-ink-muted)]">
          Gracias por tu colaboración. Desde este navegador no es necesario volver a rellenarla.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href="/informes" class="btn btn-primary btn-full sm:w-auto">Ver informes</a>
          <a href={`/estudios/${survey.study.slug}`} class="btn btn-ghost btn-full sm:w-auto">Volver al estudio</a>
        </div>
      </section>
    ) : (
      <SurveyForm
        questions={survey.questions}
        studySlug={survey.study.slug}
        errorMessage={errorMessage}
      />
    )
  }
</BaseLayout>
