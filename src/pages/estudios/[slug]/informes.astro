import BaseLayout from "@/layouts/BaseLayout.astro";
import ReportsDashboard from "@/components/ReportsDashboard.astro";
import { getUnlockCookie } from "@/lib/cookies";
import { DomainError } from "@/types";
import { assertUnlockToken, getReports, parseReportFilters } from "@/services";

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/");
}

const filters = parseReportFilters(Astro.url.searchParams);
const compare = Astro.url.searchParams.get("comparar") || "";
const token = getUnlockCookie(Astro.cookies, slug);
let locked = false;
let view;
let errorMessage: string | undefined;

<BaseLayout title={view ? `Informes · ${view.studyTitle}` : "Informes"}>
  {
    locked ? (
      <>
        <p class="eyebrow">Acceso restringido</p>

        <h1>Informes del estudio</h1>

        <p>
          Para consultar los informes completos, primero debes participar en la
          encuesta.
        </p>

        <p>
          Tu respuesta es anónima y, al finalizar, tendrás acceso inmediato al
          análisis detallado de los resultados.
        </p>

        <p>
          Podrás explorar los datos y comprobar hasta qué punto distintas
          experiencias y condiciones profesionales son compartidas por otros
          docentes de FPE.
        </p>

        <a
          href={`/estudios/${slug}/participar`}
          class="btn btn-primary btn-full sm:w-auto"
        >
          Completar la encuesta
        </a>

        <a href={`/estudios/${slug}`} class="btn btn-ghost btn-full sm:w-auto">
          Volver al estudio
        </a>
      </>
    ) : errorMessage ? (
      <p>{errorMessage}</p>
    ) : view ? (
      <ReportsDashboard
        view={view}
        filterAction={`/estudios/${slug}/informes`}
        compare={compare}
      />
    ) : null
  }
</BaseLayout>
