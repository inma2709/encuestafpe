---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ReportsDashboard from "@/components/ReportsDashboard.astro";
import { getUnlockCookie } from "@/lib/cookies";
import { DomainError } from "@/types";
import { assertUnlockToken, getReports, parseReportFilters } from "@/services";

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/");
}

const filters = parseReportFilters(Astro.url.searchParams);
const compare = Astro.url.searchParams.get("comparar") || "";
const token = getUnlockCookie(Astro.cookies, slug);
let locked = false;
let view;
let errorMessage: string | undefined;

try {
  await assertUnlockToken(slug, token);
  view = await getReports(slug, filters, compare);
} catch (err) {
  if (err instanceof DomainError && err.code === "FORBIDDEN") {
    locked = true;
  } else if (err instanceof DomainError && err.code === "NOT_FOUND") {
    return new Response(null, { status: 404, statusText: "Not Found" });
  } else {
    errorMessage = err instanceof Error ? err.message : "Error al cargar informes";
  }
}
---

<BaseLayout title={view ? `Informes · ${view.studyTitle}` : "Informes"}>
  {
    locked ? (
      <section class="fade-up space-y-8">
        <p class="eyebrow">Acceso restringido</p>
        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl text-balance">Informes</h1>
        <p class="lede">
          Para ver los datos completos, rellena antes la encuesta. <strong>Todos participamos, todos sumamos.</strong>
        </p>
        <p class="text-[var(--color-ink-muted)]">
          Tu respuesta anónima te dará acceso inmediato a los informes detallados del estudio.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href={`/estudios/${slug}/participar`} class="btn btn-primary btn-full sm:w-auto">
            Completar la encuesta
          </a>
          <a href="/informes" class="btn btn-ghost btn-full sm:w-auto">
            Ver hub público
          </a>
        </div>
      </section>
    ) : errorMessage ? (
      <p class="text-[var(--color-danger)]">{errorMessage}</p>
    ) : view ? (
      <ReportsDashboard
        view={view}
        filterAction={`/estudios/${slug}/informes`}
        compare={compare}
      />
    ) : null
  }
</BaseLayout>
