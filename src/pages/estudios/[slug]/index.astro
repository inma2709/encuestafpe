---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { DomainError } from "@/types";
import { getActiveSurvey } from "@/services";

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/");
}

let survey;
let loadError: string | null = null;

try {
  survey = await getActiveSurvey(slug);
} catch (err) {
  if (err instanceof DomainError && err.code === "NOT_FOUND") {
    return new Response(null, { status: 404, statusText: "Not Found" });
  }
  loadError = err instanceof Error ? err.message : "Error al cargar el estudio";
}
---

<BaseLayout title={survey?.study.title} description={survey?.study.summary ?? undefined}>
  {
    loadError || !survey ? (
      <p class="text-[var(--color-danger)]">{loadError ?? "Estudio no disponible"}</p>
    ) : (
      <article class="fade-up space-y-10">
        <header class="space-y-5">
          <div class="flex flex-wrap items-center gap-3">
            <span class="badge">Oleada {survey.wave.label}</span>
            <span class="text-sm text-[var(--color-ink-muted)]">Instrumento {survey.version.versionLabel}</span>
          </div>
          <h1 class="font-display text-2xl sm:text-3xl lg:text-5xl text-balance">{survey.study.title}</h1>
          {survey.study.summary && <p class="lede">{survey.study.summary}</p>}
        </header>

        <div class="callout space-y-3 text-[var(--color-ink-muted)]">
          <p>
            Participación completamente anónima. Recogemos variables demográficas y profesionales
            agregables —nunca identidad personal.
          </p>
          <p>
            Tras el envío puedes consultar resultados e informes. Las celdas con pocas respuestas se ocultan.
          </p>
        </div>

        <div class="space-y-4">
          <aside class="callout space-y-3 text-sm leading-relaxed text-[var(--color-ink-muted)]" aria-label="Información antes de comenzar la encuesta">
            <p class="font-medium text-[var(--color-ink)]">
              La encuesta solo puede completarse una vez por dispositivo, para evitar respuestas duplicadas y proteger la fiabilidad de los resultados.
            </p>
            <p>No es necesario registrarse ni facilitar datos personales.</p>
            <p><strong>Al completar y enviar la encuesta, se contabilizará tu participación.</strong></p>
          </aside>

          <div class="flex flex-col gap-3 sm:flex-row">
            <div class="flex flex-col gap-2">
              <a
                href={`/estudios/${survey.study.slug}/participar`}
                class="btn btn-primary btn-full sm:w-auto"
              >
                {survey.study.status === "open" ? "Comenzar encuesta" : "Ver encuesta"}
                <Icon name="arrow-right" size={18} />
              </a>
              {survey.study.status === "open" && (
                <p class="text-center text-xs text-[var(--color-ink-muted)] sm:text-left">
                  Al completarla, se contabilizará tu participación.
                </p>
              )}
            </div>
          <a href="/informes" class="btn btn-ghost btn-full sm:w-auto">
            <Icon name="chart-bar" size={18} />
            Ver informes
          </a>
          </div>
        </div>
      </article>
    )
  }
</BaseLayout>
